{
  "$schema": "urn:readable-studio:schema:plugin-manifest:v1",
  "specVersion": "1.0.0",
  "name": "sample-plugin",
  "title": "Sample Plugin",
  "version": "1.0.0",
  "description": "Phase 1 e2e fixture used by readable plugin install/apply walkthroughs.",
  "license": "MIT",
  "tags": [
    "sample",
    "phase1"
  ],
  "readable": {
    "kind": "skill",
    "taskKind": "new-generation",
    "useCase": {
      "query": "Generate a {{topic}} brief for {{audience}}."
    },
    "context": {
      "skills": [
        {
          "ref": "readable-landing"
        }
      ],
      "atoms": [
        "todo-write",
        "discovery-question-form"
      ]
    },
    "inputs": [
      {
        "name": "topic",
        "type": "string",
        "required": true,
        "label": "Topic"
      },
      {
        "name": "audience",
        "type": "select",
        "options": [
          "VC pitch",
          "general"
        ],
        "default": "general"
      }
    ],
    "capabilities": [
      "prompt:inject"
    ]
  }
}
