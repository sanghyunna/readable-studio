{
  "name": "@readable-studio/tools-pack",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "bin": {
    "tools-pack": "./bin/tools-pack.mjs"
  },
  "scripts": {
    "build": "node ./esbuild.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly && node --experimental-strip-types ../../packages/metatool/src/cli.ts write .",
    "dev": "tsx ./src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "hosted:pi:build": "node --experimental-strip-types ./src/hosted-pi-artifact.ts build",
    "hosted:pi:check": "node --experimental-strip-types ./src/hosted-pi-artifact.ts check"
  },
  "dependencies": {
    "@readable-studio/platform": "workspace:*",
    "@readable-studio/product-identity": "workspace:*",
    "@readable-studio/sidecar": "workspace:*",
    "@readable-studio/sidecar-proto": "workspace:*",
    "cac": "6.7.14",
    "electron-builder": "26.8.1",
    "resedit": "1.7.2"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "esbuild": "0.28.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": "~24"
  }
}
