{
  "name": "@readable-studio/sidecar",
  "version": "1.3.6",
  "private": true,
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "node ./esbuild.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile ../../.tmp/typecheck/sidecar.typecheck.tsbuildinfo && tsc -p tsconfig.tests.json --noEmit --incremental --tsBuildInfoFile ../../.tmp/typecheck/sidecar.tests.typecheck.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "esbuild": "0.28.0",
    "vitest": "4.1.6",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "~24"
  }
}
