{
  "name": "@readable-studio/html-edit",
  "version": "1.3.6",
  "private": true,
  "type": "module",
  "description": "Pure, source-local HTML width release records and restoration.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile ../../.tmp/typecheck/html-edit.typecheck.tsbuildinfo && tsc -p tsconfig.tests.json --noEmit --incremental --tsBuildInfoFile ../../.tmp/typecheck/html-edit.tests.typecheck.tsbuildinfo"
  },
  "dependencies": {
    "css-tree": "3.2.1",
    "parse5": "8.0.1"
  },
  "devDependencies": {
    "@types/css-tree": "3.2.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "engines": {"node": "~24"}
}
