{
  "name": "readable-studio",
  "version": "0.2.2",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "description": "Document workspace that turns source text into directly editable, standalone HTML.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanghyunna/readable-studio.git"
  },
  "homepage": "https://github.com/sanghyunna/readable-studio#readme",
  "bugs": {
    "url": "https://github.com/sanghyunna/readable-studio/issues"
  },
  "bin": {
    "readable": "./apps/daemon/bin/readable.mjs"
  },
  "scripts": {
    "postinstall": "node ./scripts/postinstall.mjs",
    "tools-dev": "pnpm exec tools-dev",
    "tools-pack": "pnpm exec tools-pack",
    "guard": "tsx ./scripts/guard.ts && node --import tsx --test scripts/style-policy.test.ts scripts/product-neutrality.test.ts scripts/check-cross-app-imports.test.ts scripts/postinstall.test.ts scripts/bundled-copy-language.test.ts scripts/json-resources.test.ts",
    "i18n:check": "tsx ./scripts/i18n-check.ts",
    "i18n:coverage": "tsx ./scripts/i18n-coverage-report.ts",
    "sync:community-pets": "node --experimental-strip-types scripts/sync-community-pets.ts",
    "bake:community-pets": "node --experimental-strip-types scripts/bake-community-pets.ts",
    "seed:test-projects": "node --experimental-strip-types scripts/seed-test-projects.ts",
    "seed:curated-design-skills": "node --experimental-strip-types scripts/seed-curated-design-skills.ts",
    "backfill:failed-runs": "node --experimental-strip-types scripts/backfill-failed-runs-with-artifacts.ts",
    "typecheck": "pnpm -r --workspace-concurrency=4 --if-present run typecheck && tsc -p scripts/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@readable-studio/components": "workspace:*",
    "@readable-studio/daemon": "workspace:*",
    "@readable-studio/tools-dev": "workspace:*",
    "@readable-studio/tools-pack": "workspace:*",
    "@types/node": "20.19.39",
    "tsx": "4.22.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "~24",
    "pnpm": ">=10.33.2 <11"
  },
  "pnpm": {
    "patchedDependencies": {
      "@earendil-works/pi-coding-agent@0.83.0": "patches/@earendil-works__pi-coding-agent@0.83.0.patch"
    },
    "overrides": {
      "brace-expansion": "5.0.9",
      "devalue": "5.8.1",
      "fast-uri": "3.1.5",
      "hono": "4.12.25",
      "ip-address": "10.3.1",
      "jsdom>undici": "7.29.0",
      "postcss": "8.5.15",
      "protobufjs": "8.4.1",
      "qs": "6.15.2",
      "tmp": "0.2.7",
      "undici": "8.10.0",
      "yaml": "2.9.0"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "core-js",
      "electron",
      "esbuild",
      "protobufjs",
      "sharp"
    ]
  }
}
